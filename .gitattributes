# Normalise text files (LF in the repo)
* text=auto eol=lf

# Images / spreadsheets are binary
*.png binary
*.xlsx binary

# Vendored third-party libraries: keep them, hide from diffs + language stats
static/js/vendor/* linguist-vendored -diff
web/vendor/* linguist-vendored -diff

# Generated by scripts/build_static.py
static/js/data.js linguist-generated
dist/index.html linguist-generated
